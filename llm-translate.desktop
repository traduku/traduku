[Desktop Entry]
Type=Application
Name=LLM Translate
GenericName=Clipboard translator
Comment=Translate the clipboard with an LLM (double Ctrl+C, streaming)
Exec=kde-llm-translate
Icon=accessories-dictionary
Terminal=false
Categories=Utility;Translation;Qt;KDE;
X-KDE-autostart-after=panel
X-DBus-ServiceName=org.kde.kde-llm-translate
StartupNotify=false
