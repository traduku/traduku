# Maintainer: LLM Translate contributors <dev@localhost>
pkgname=kde-llm-translate
pkgver=0.1
pkgrel=1
pkgdesc='Clipboard translator powered by any OpenAI-compatible LLM (streaming; KDE Plasma, any DE)'
arch=('x86_64')
url='https://github.com/localhost/kde-llm-translate'
license=('GPL3')
# KF6 component packages: un-prefixed names resolve on Arch (kf6-* Provides)
# and on CachyOS (installed as bare names).
depends=('qt6-base' 'qt6-multimedia' 'qt6-5compat'
         'kstatusnotifieritem' 'knotifications' 'kglobalaccel'
         'kdbusaddons' 'libx11' 'libxi' 'libxtst')
makedepends=('cmake' 'ninja')
optdepends=('wl-clipboard: clipboard access on pure Wayland')
source=("kde-llm-translate-${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  cmake -B build -G Ninja -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  QT_QPA_PLATFORM=offscreen ctest --test-dir build --output-on-failure
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  DESTDIR="$pkgdir" cmake --install build
}
