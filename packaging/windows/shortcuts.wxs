<?xml version="1.0" encoding="UTF-8"?>
<!--
  The two shortcuts, and the two rules they obey.

  A shortcut component needs a key path, and the honest key path for a shortcut
  is a registry value: the .lnk file is created by the installer, not copied
  from the package, and a component keyed on a file the installer synthesises
  breaks in ways the Repair button cannot fix. The values live under
  HKCU\Software\traduku\installer - per-user, because "Installed apps" shows
  one machine-wide product while Start Menu and Desktop are per-user surfaces:
  the MSI installs once for the machine, and each account decides for its own
  shell. Two users, two desktop icons, one traduku.

  Uninstall removes the HKCU key of the account that runs the uninstall - the
  one place where a per-machine installer and per-user shortcuts genuinely do
  not meet, and the standard answer: Windows does the same thing for every
  per-user Start Menu shortcut installed by an MSI.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Fragment>

        <DirectoryRef Id="AppMenuFolder">
            <Component Id="StartMenuShortcut" Guid="*">
                <Shortcut Id="StartMenuLink" Name="traduku"
                          Target="[INSTALLFOLDER]traduku.exe"
                          WorkingDirectory="INSTALLFOLDER" />
                <RemoveFolder Id="RemoveAppMenuFolder" Directory="AppMenuFolder" On="uninstall" />
                <RegistryValue Root="HKCU" Key="Software\traduku\installer"
                               Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
            </Component>
        </DirectoryRef>

        <DirectoryRef Id="DesktopFolder">
            <!-- On by default, off with `msiexec /i traduku-x.msi CREATEDESKTOPSHORTCUT=0`:
                 a tray app lives in the tray, so the desktop icon is a
                 convenience, and a package that puts one there without being
                 asked has taken something from the user's desktop. It is
                 removable (uninstall takes it back), which is what makes it
                 acceptable to ship on by default. -->
            <Component Id="DesktopShortcut" Guid="*">
                <!-- WiX v3 spells a component condition as a bare element: the body is
                     evaluated at install time, and a component whose condition is
                     false is simply not installed - the shortcut is never created,
                     so there is nothing for uninstall to take back. -->
                <Condition>CREATEDESKTOPSHORTCUT</Condition>
                <Shortcut Id="DesktopLink" Name="traduku"
                          Target="[INSTALLFOLDER]traduku.exe"
                          WorkingDirectory="INSTALLFOLDER" />
                <RegistryValue Root="HKCU" Key="Software\traduku\installer"
                               Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
            </Component>
        </DirectoryRef>

        <Property Id="CREATEDESKTOPSHORTCUT" Value="1" />
    </Fragment>
</Wix>
