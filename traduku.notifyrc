[Global]
IconName=accessories-dictionary
DesktopEntry=traduku
Comment=Traduku clipboard translator

[Event traduku-notify]
Name=Translation progress
Description=Status messages from the clipboard translator
Sound=
Action=Popup
PreserveConfig=true

[Event Translating]
Name=Translating clipboard
Action=Sound
Sound=bell.oga
PreserveConfig=true

[Event Translated]
Name=Translation finished
Action=Sound
Sound=complete.oga
PreserveConfig=true

[Event TranslationFailed]
Name=Translation failed
Action=Sound
Sound=dialog-error.oga
PreserveConfig=true
