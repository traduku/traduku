build*/
# Anchored: without the leading slash this matched at any depth and swallowed
# packaging/windows/build-portable.sh, so the release script existed only on the
# machine that wrote it (tests/cmake/test_packaging_tracked.sh now fails on that).
/build-*
*.user
.cache/
compile_commands.json
release-out/
tests/e2e/__pycache__/
__pycache__/
.pytest_cache/
.venv
release-assets/
dist/
